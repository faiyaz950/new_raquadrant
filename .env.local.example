# Copy this file to .env.local in the project root, then fill in values from your Firebase project.
# Firebase Console: https://console.firebase.google.com → your project → Project settings (gear)
# → Your apps → Web app (</>) → Register app if needed → copy the `firebaseConfig` values.
#
# After saving .env.local, restart `npm run dev` so Next.js picks up the variables.

# --- Client (browser) — required for Admin login, Firestore CMS, Storage uploads ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Contact form email ---
# Uses Resend HTTPS API from src/app/api/contact/route.ts (API key is set in that file for this project).
