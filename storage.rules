rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Admin uploads: paths must match src/lib/storage.ts + admin pages (uploadImage folder arg).
    // Public read so site can show images via download URLs; writes require signed-in user.
    match /{folder}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && folder in [
          'hero-slides',
          'about-hero-slides',
          'intro-images',
          'testimonials',
          'partners',
          'project-images'
        ]
        && request.resource.size < 5 * 1024 * 1024
        // Accept any image/* (browser / canvas may vary slightly, e.g. image/pjpeg)
        && request.resource.contentType.matches('image/.*');
    }
  }
}
