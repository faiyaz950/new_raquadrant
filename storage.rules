rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isCmsPathName(name) {
      return name.matches(
        '^(hero-slides|about-hero-slides|intro-images|testimonials|partners|project-images)/.+'
      );
    }

    // Full object path (e.g. about-hero-slides/173_file.jpg).
    function isCmsImagePath() {
      return isCmsPathName(request.resource.name);
    }

    function isImageContentType() {
      // Some clients omit contentType or send octet-stream even for images from canvas/Blob.
      return request.resource.contentType == null
        || request.resource.contentType.matches('image/.*')
        || request.resource.contentType == 'application/octet-stream';
    }

    match /{allPaths=**} {
      allow read: if isCmsPathName(resource.name);
      allow write: if request.auth != null
        && isCmsImagePath()
        && request.resource.size < 5 * 1024 * 1024
        && isImageContentType();
    }
  }
}
